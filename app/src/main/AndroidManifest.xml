<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 精确闹钟权限（吃药/喝水/久坐准点提醒） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Android 13+ 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自动恢复闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 震动与锁屏唤醒全屏强提醒 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Android 11+ 查询系统 TTS 引擎 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_care"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_care"
        android:supportsRtl="true"
        android:theme="@style/Theme.CareReminder"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CareReminder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 锁屏全屏强提醒页面（老人吃药/喝水/久坐弹窗打卡或延后10分钟） -->
        <activity
            android:name=".ui.AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.CareReminder" />

        <!-- 定时闹钟触发广播接收器 -->
        <receiver
            android:name=".alarm.ReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 通知栏快捷按钮（已完成 / 延后10分钟）接收器 -->
        <receiver
            android:name=".alarm.NotificationActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 手机重启或应用更新后自动重新注册闹钟 -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
